#!/bin/bash

set -euo pipefail

pack_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
backup_root="$HOME/.local/state/omarchy-dreamscapes/backups/$(date +%Y%m%d-%H%M%S)"
shell_config="$HOME/.config/omarchy/shell.json"
bindings="$HOME/.config/hypr/bindings.lua"
plugin_dir="$HOME/.config/omarchy/plugins/dreamscapes.workspaces"
cycle_command="$HOME/.local/bin/omarchy-theme-cycle-dreamscapes"

command -v omarchy >/dev/null || { echo "Omarchy is required." >&2; exit 1; }
command -v jq >/dev/null || { echo "jq is required." >&2; exit 1; }
[[ -f $shell_config ]] || { echo "Missing $shell_config" >&2; exit 1; }
[[ -f $bindings ]] || { echo "Missing $bindings" >&2; exit 1; }

mkdir -p "$backup_root" "$plugin_dir" "$(dirname "$cycle_command")"
cp "$shell_config" "$backup_root/shell.json"
cp "$bindings" "$backup_root/bindings.lua"
cp "$pack_dir/plugins/dreamscapes.workspaces/manifest.json" "$plugin_dir/manifest.json"
cp "$pack_dir/plugins/dreamscapes.workspaces/Workspaces.qml" "$plugin_dir/Workspaces.qml"
install -m 755 "$pack_dir/bin/omarchy-theme-cycle-dreamscapes" "$cycle_command"

omarchy hook install theme-set "$pack_dir/hooks/theme-set.d/dreamscapes-profile"
omarchy hook install post-boot "$pack_dir/hooks/post-boot.d/dreamscapes-profile"

shell_tmp=$(mktemp)
jq -a 'walk(if type == "object" and (.id? | type) == "string" and (.id | test("(^|\\.)workspaces$")) then .id = "dreamscapes.workspaces" else . end)' "$shell_config" > "$shell_tmp"
install -m 644 "$shell_tmp" "$shell_config"
rm -f "$shell_tmp"

# Repair markers written by earlier versions: bindings.lua is Lua, where a bare
# '#' is the length operator rather than a comment. The '--#' form keeps the
# '# BEGIN/END OMARCHY DREAMSCAPES' text that the guard below and the
# uninstaller match on, while making the line a valid Lua comment.
sed -i -E 's/^# ((BEGIN|END) OMARCHY DREAMSCAPES)$/--# \1/' "$bindings"

if ! grep -Fq '# BEGIN OMARCHY DREAMSCAPES' "$bindings"; then
  printf '\n%s\n%s\n%s\n' \
    '--# BEGIN OMARCHY DREAMSCAPES' \
    'o.bind("SUPER + SHIFT + CTRL + T", "Cycle Dreamscapes theme", os.getenv("HOME") .. "/.local/bin/omarchy-theme-cycle-dreamscapes")' \
    '--# END OMARCHY DREAMSCAPES' >> "$bindings"
fi

omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
hyprctl reload >/dev/null 2>&1 || true

echo "Dreamscapes Experience Pack installed."
echo "Backups: $backup_root"
